{
  "name": "latex-editor",
  "version": "0.5.0",
  "private": true,
  "description": "Monorepo for the LaTeX Editor desktop and future web applications",
  "workspaces": [
    "latex-editor-desktop",
    "latex-editor-web"
  ],
  "engines": {
    "node": "20.19.5"
  },
  "scripts": {
    "start": "npm --workspace latex-editor-desktop start",
    "test": "npm --workspace latex-editor-desktop test",
    "check": "npm --workspace latex-editor-desktop run check",
    "setup:desktop": "npm --workspace latex-editor-desktop run setup",
    "pack": "npm --workspace latex-editor-desktop run pack",
    "dist": "npm --workspace latex-editor-desktop run dist",
    "build:installer": "npm --workspace latex-editor-desktop run build:installer",
    "build:portable": "npm --workspace latex-editor-desktop run build:portable",
    "web:dev": "npm --workspace latex-editor-web run dev",
    "web:build": "npm --workspace latex-editor-web run build",
    "web:test": "npm --workspace latex-editor-web test"
  }
}
