{
  "name": "latex-editor-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/worker.test.js",
    "test:operations": "node --experimental-sqlite --test test/operations.test.js test/backup.test.js",
    "backup": "npm exec --yes --package=node@22.12.0 --package=wrangler@4.120.0 -- node --experimental-sqlite scripts/cloud-backup.mjs",
    "check": "node --check src/index.js && node --check src/operations.js && node --check scripts/backup-lib.mjs && node --check scripts/cloud-backup.mjs",
    "dev": "npx wrangler@4.120.0 dev",
    "deploy": "npx wrangler@4.120.0 deploy"
  },
  "dependencies": {
    "yjs": "^13.6.33"
  }
}
